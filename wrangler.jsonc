{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dataformatconverter",
  "compatibility_date": "2026-11-04",
  "observability": {
    "enabled": false
  },
  "routes": [
    { "pattern": "dataformatconverter.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "dist",
    "not_found_handling": "404-page"
  }
}
